<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Run collections sequentially: real socket deadlines, process-wide catalogs and collectible mod contexts
         must not compete with unrelated collections' loads/GC. Individual tests still exercise concurrent tasks.
         Keep threads uncapped so synchronous fixture setup cannot starve async continuations. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer.Gateway\GameServer.Gateway.csproj" />
    <!-- Copied beside the tests for ModHostTests, which load it as a mod; no test uses its types directly. -->
    <ProjectReference Include="..\GameServer.Modding.TestMod\GameServer.Modding.TestMod.csproj" />
    <!-- The league modules: TestEnvironment registers them, as the host does in the server. -->
    <ProjectReference Include="..\..\Modules\ruthless\Ruthless.csproj" />
    <ProjectReference Include="..\..\Modules\Core\harvest\Harvest.csproj" />
    <ProjectReference Include="..\..\Modules\Core\hideoutediting\HideoutEditing.csproj" />
    <ProjectReference Include="..\..\Modules\Core\commands\Commands.csproj" />
    <ProjectReference Include="..\..\Modules\Core\vendors\Vendors.csproj" />
    <ProjectReference Include="..\..\Modules\Core\portals\Portals.csproj" />
    <ProjectReference Include="..\..\Modules\Core\questobjects\QuestObjects.csproj" />
    <ProjectReference Include="..\..\Modules\Core\uniquebelts\UniqueBelts.csproj" />
    <ProjectReference Include="..\..\Modules\Core\mercy\Mercy.csproj" />
    <ProjectReference Include="..\..\Modules\Core\tattoos\Tattoos.csproj" />
    <ProjectReference Include="..\..\Modules\Core\delve\Delve.csproj" />
  </ItemGroup>
</Project>
