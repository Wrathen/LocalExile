    <InternalsVisibleTo Include="cosmetics" />
    <InternalsVisibleTo Include="bench" />
    <InternalsVisibleTo Include="atlas" />
    <InternalsVisibleTo Include="social" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
